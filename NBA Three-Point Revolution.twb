    <worksheet name='3PA Rate Heat Map'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>The Rise of the Three  </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='NBA_Players_Report+' name='federated.1c37n880r97gae1ccn3pa15j4k63' />
          </datasources>
          <datasource-dependencies datasource='federated.1c37n880r97gae1ccn3pa15j4k63'>
            <column caption='Positions' datatype='string' name='[Calculation_2862305390899201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [position] = &apos;PG&apos; THEN &apos;Guard&apos;&#13;&#10;ELSEIF [position] = &apos;SG&apos; THEN &apos;Guard&apos;&#13;&#10;ELSEIF [position] = &apos;SF&apos; THEN &apos;Wing&apos;&#13;&#10;ELSEIF [position] = &apos;PF&apos; THEN &apos;Big&apos;&#13;&#10;ELSEIF [position] = &apos;C&apos;  THEN &apos;Big&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Era - Shot Zones' datatype='string' name='[Calculation_2862305597333508]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [season] &gt;= 1997 AND [season] &lt;= 2005 THEN &quot;Era 1 (1997-2005)&quot;&#13;&#10;ELSEIF [season] &gt;= 2006 AND [season] &lt;= 2012 THEN &quot;Era 2 (2006-2012)&quot;&#13;&#10;ELSEIF [season] &gt;= 2013 AND [season] &lt;= 2025 THEN &quot;Era 3 (2013-2025)&quot;&#13;&#10;ELSE NULL END' />
            </column>
            <column caption='Avg 3PA Rate' datatype='real' name='[Calculation_2862306132443172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(AVG([three_attempt_rt]), 4) * 100' />
            </column>
            <column-instance column='[Calculation_2862305390899201]' derivation='None' name='[none:Calculation_2862305390899201:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2862305597333508]' derivation='None' name='[none:Calculation_2862305597333508:nk]' pivot='key' type='nominal' />
            <column-instance column='[team (NBA_Teams_Report.csv)]' derivation='None' name='[none:team (NBA_Teams_Report.csv):nk]' pivot='key' type='nominal' />
            <column caption='Position' datatype='string' name='[position]' role='dimension' type='nominal' />
            <column caption='Season' datatype='integer' name='[season]' role='dimension' type='ordinal' />
            <column caption='Teams' datatype='string' name='[team (NBA_Teams_Report.csv)]' role='dimension' type='nominal' />
            <column caption='3PA Rate' datatype='real' name='[three_attempt_rt]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2862306132443172]' derivation='User' name='[usr:Calculation_2862306132443172:qk]' pivot='key' type='quantitative' />
