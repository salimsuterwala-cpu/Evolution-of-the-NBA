    <worksheet name='Stretch Big Era 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>1980-1989</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>Avg 3PA Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='NBA_Players_Report+' name='federated.1c37n880r97gae1ccn3pa15j4k63' />
          </datasources>
          <datasource-dependencies datasource='federated.1c37n880r97gae1ccn3pa15j4k63'>
            <column caption='Big Men' datatype='string' name='[Calculation_1329862787317760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[position] = &apos;C&apos; THEN &apos;C&apos;&#13;&#10;ELSEIF [position] = &apos;PF&apos; THEN &apos;PF&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Eras - Top Players' datatype='string' name='[Calculation_2862305390456832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [season] &gt;= 1980 AND [season] &lt;= 1989 THEN &apos;(1980-1989) Era 1&apos;&#13;&#10;ELSEIF [season] &gt;= 1990 AND [season] &lt;= 1999 THEN &apos;(1990-1999) Era 2&apos;&#13;&#10;ELSEIF [season] &gt;= 2000 AND [season] &lt;= 2012 THEN &apos;(2000-2012) Era 3&apos;&#13;&#10;ELSEIF [season] &gt;= 2013 AND [season] &lt;= 2025 THEN &apos;(2013-2025) Era 4&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Stretch Big' datatype='string' name='[Calculation_2862305391108098]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([position] = &apos;C&apos; OR [position] = &apos;PF&apos;) AND [three_attempt_rt] &gt; 0.10 THEN &apos;Stretch Big&apos;&#13;&#10;ELSEIF ([position] = &apos;C&apos; OR [position] = &apos;PF&apos;) AND [three_attempt_rt] &lt;= 0.10 THEN &apos;Traditional Big&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Qualified Players' datatype='boolean' name='[Calculation_2862305406185475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[minutes_played] &gt;= 1500' />
            </column>
            <column caption='Avg 3PA Rate' datatype='real' name='[Calculation_2862306132443172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(AVG([three_attempt_rt]), 4) * 100' />
            </column>
            <column caption='Minutes Played' datatype='integer' name='[minutes_played]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2862305390456832]' derivation='None' name='[none:Calculation_2862305390456832:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2862305391108098]' derivation='None' name='[none:Calculation_2862305391108098:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2862305406185475]' derivation='None' name='[none:Calculation_2862305406185475:nk]' pivot='key' type='nominal' />
            <column-instance column='[season]' derivation='None' name='[none:season:ok]' pivot='key' type='ordinal' />
            <column-instance column='[team (NBA_Teams_Report.csv)]' derivation='None' name='[none:team (NBA_Teams_Report.csv):nk]' pivot='key' type='nominal' />
            <column caption='Position' datatype='string' name='[position]' role='dimension' type='nominal' />
            <column caption='Season' datatype='integer' name='[season]' role='dimension' type='ordinal' />
            <column caption='Teams' datatype='string' name='[team (NBA_Teams_Report.csv)]' role='dimension' type='nominal' />
            <column caption='3PA Rate' datatype='real' name='[three_attempt_rt]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2862306132443172]' derivation='User' name='[usr:Calculation_2862306132443172:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
